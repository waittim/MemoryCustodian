{
  "groups": {
    "version": [
      {
        "path": "pyproject.toml",
        "regex": "^version = \"([^\"]+)\""
      },
      {
        "path": "cli/memory_custodian/__init__.py",
        "regex": "^__version__ = \"([^\"]+)\""
      },
      {
        "path": ".codex-plugin/plugin.json",
        "json_path": "version"
      },
      {
        "path": ".claude-plugin/plugin.json",
        "json_path": "version"
      },
      {
        "path": ".claude-plugin/marketplace.json",
        "json_path": "plugins.0.version"
      },
      {
        "path": "README.md",
        "regex": "version-([0-9.]+)-blue"
      }
    ],
    "protocol_version": [
      {
        "path": "cli/memory_custodian/__init__.py",
        "regex": "^__protocol_version__ = \"([^\"]+)\""
      },
      {
        "path": "templates/minimal/manifest.md",
        "regex": "^- protocol_version: ([0-9.]+)"
      },
      {
        "path": "docs/memory/manifest.md",
        "regex": "^- protocol_version: ([0-9.]+)"
      },
      {
        "path": "examples/nightnotes-video-demo/docs/memory/manifest.md",
        "regex": "^- protocol_version: ([0-9.]+)"
      }
    ],
    "entry_schema_version": [
      {
        "path": "cli/memory_custodian/__init__.py",
        "regex": "^__entry_schema_version__ = \"([^\"]+)\""
      },
      {
        "path": "templates/minimal/manifest.md",
        "regex": "^- entry_schema_version: ([0-9]+)"
      },
      {
        "path": "docs/memory/manifest.md",
        "regex": "^- entry_schema_version: ([0-9]+)"
      },
      {
        "path": "examples/nightnotes-video-demo/docs/memory/manifest.md",
        "regex": "^- entry_schema_version: ([0-9]+)"
      }
    ],
    "subject_schema_version": [
      {
        "path": "cli/memory_custodian/__init__.py",
        "regex": "^__subject_schema_version__ = \\\"([^\\\"]+)\\\""
      },
      {
        "path": "templates/minimal/manifest.md",
        "regex": "^- subject_schema_version: ([0-9]+)"
      },
      {
        "path": "docs/memory/manifest.md",
        "regex": "^- subject_schema_version: ([0-9]+)"
      },
      {
        "path": "examples/nightnotes-video-demo/docs/memory/manifest.md",
        "regex": "^- subject_schema_version: ([0-9]+)"
      }
    ],
    "routing_schema_version": [
      {
        "path": "cli/memory_custodian/__init__.py",
        "regex": "^__routing_schema_version__ = \\\"([^\\\"]+)\\\""
      },
      {
        "path": "templates/minimal/manifest.md",
        "regex": "^- routing_schema_version: ([0-9]+)"
      },
      {
        "path": "docs/memory/manifest.md",
        "regex": "^- routing_schema_version: ([0-9]+)"
      },
      {
        "path": "examples/nightnotes-video-demo/docs/memory/manifest.md",
        "regex": "^- routing_schema_version: ([0-9]+)"
      }
    ],
    "conflict_schema_version": [
      {
        "path": "cli/memory_custodian/__init__.py",
        "regex": "^__conflict_schema_version__ = \\\"([^\\\"]+)\\\""
      },
